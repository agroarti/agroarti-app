<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover">
<title>АгроАрти</title>
<script src="https://telegram.org/js/telegram-web-app.js"></script>
<style>
  :root{
    --bg:#05201a; --bg2:#0a3a2a; --card:rgba(255,255,255,.075); --card2:rgba(255,255,255,.12);
    --line:rgba(255,255,255,.15); --text:#f2f8f4; --muted:#9fbcad; --gold:#ffcd50; --gold2:#e0a100;
    --green:#34c06f; --danger:#ff7a6b;
  }
  *{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
  html,body{margin:0;height:100%;background:var(--bg);color:var(--text);
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;overflow:hidden}
  body{display:flex;flex-direction:column;
    background:radial-gradient(900px 420px at 85% -10%,rgba(255,176,52,.28),transparent 60%),
               linear-gradient(180deg,var(--bg2),var(--bg) 60%)}
  /* рифлёное стекло в шапке */
  header{position:relative;padding:calc(env(safe-area-inset-top,0px) + 14px) 18px 14px;display:flex;align-items:center;gap:12px;
    background:repeating-linear-gradient(90deg,rgba(255,255,255,.07) 0 9px,rgba(0,0,0,.10) 9px 12px);
    border-bottom:1px solid var(--line)}
  header svg{flex:none;filter:drop-shadow(0 0 10px rgba(255,190,60,.55))}
  .brand{font-weight:900;font-size:22px;letter-spacing:.2px;line-height:1.1}
  .sub{font-size:12.5px;color:var(--muted);margin-top:2px}
  main{flex:1;overflow-y:auto;padding:16px 16px 170px;-webkit-overflow-scrolling:touch}
  section{display:none;animation:in .25s ease}
  section.on{display:block}
  @keyframes in{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
  h2{font-size:13px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.9px;margin:20px 4px 10px}
  h2:first-child{margin-top:4px}
  .card{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:14px;margin-bottom:12px;
    backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px)}
  .row{display:flex;align-items:center;justify-content:space-between;gap:12px}
  .title{font-weight:700;font-size:16px}
  .hint{font-size:12.5px;color:var(--muted);margin-top:3px;line-height:1.4}
  /* переключатель */
  .sw{position:relative;width:54px;height:32px;flex:none}
  .sw input{opacity:0;position:absolute;inset:0;width:100%;height:100%;margin:0;z-index:2}
  .sw i{position:absolute;inset:0;border-radius:20px;background:rgba(255,255,255,.18);transition:.2s}
  .sw i::after{content:"";position:absolute;left:3px;top:3px;width:26px;height:26px;border-radius:50%;background:#fff;transition:.2s}
  .sw input:checked + i{background:var(--green)}
  .sw input:checked + i::after{transform:translateX(22px)}
  /* время (всегда 24 часа) */
  .tpick{display:flex;align-items:center;justify-content:center;gap:10px}
  .tpick b{font-size:42px;color:var(--gold);font-weight:800}
  .tpick select{width:40%;font-size:44px;font-weight:800;color:var(--gold);background:rgba(0,0,0,.25);
    border:1px solid var(--line);border-radius:16px;padding:8px 4px;text-align:center;text-align-last:center;
    -webkit-appearance:none;appearance:none;outline:none;font-family:inherit;color-scheme:dark}
  .tpick select:focus{border-color:var(--gold)}
  /* чипы и сегменты */
  .chips{display:grid;grid-template-columns:repeat(7,1fr);gap:6px}
  .chip{min-width:0;text-align:center;padding:10px 0;border-radius:12px;background:rgba(255,255,255,.09);
    border:1px solid var(--line);font-weight:700;font-size:14px;cursor:pointer;user-select:none;transition:.15s}
  .chip.on{background:var(--gold);color:#2a2000;border-color:var(--gold)}
  .seg{display:grid;gap:6px}
  .seg.c4{grid-template-columns:repeat(4,1fr)} .seg.c2{grid-template-columns:repeat(2,1fr)}
  .seg .chip{padding:11px 4px;font-size:13px}
  /* получатели */
  .rcpt{display:flex;align-items:center;gap:12px;padding:12px;border-radius:14px;background:rgba(255,255,255,.07);
    border:1px solid var(--line);margin-bottom:8px;cursor:pointer;user-select:none}
  .rcpt .box{width:24px;height:24px;border-radius:8px;border:2px solid var(--muted);flex:none;display:grid;place-items:center;font-size:15px;color:transparent}
  .rcpt.on{border-color:var(--green);background:rgba(52,192,111,.14)}
  .rcpt.on .box{background:var(--green);border-color:var(--green);color:#04210f}
  .preview{font-size:14px;line-height:1.5;color:#e6f2ea;background:rgba(255,205,80,.10);border:1px dashed rgba(255,205,80,.5);
    border-radius:14px;padding:12px}
  .preview b{color:var(--gold)}
  /* калькуляторы */
  .tiles{display:grid;grid-template-columns:1fr 1fr;gap:10px}
  .tile{padding:14px 12px;border-radius:16px;background:var(--card);border:1px solid var(--line);cursor:pointer;
    display:flex;flex-direction:column;gap:6px;transition:.15s}
  .tile .ic{font-size:26px} .tile .t{font-weight:700;font-size:15px}
  .tile .d{font-size:11.5px;color:var(--muted);line-height:1.3}
  .tile.on{background:linear-gradient(160deg,rgba(255,205,80,.28),rgba(255,205,80,.08));border-color:var(--gold)}
  label.f{display:block;margin-bottom:10px}
  label.f span{display:block;font-size:12.5px;color:var(--muted);margin:0 2px 5px}
  input.in{width:100%;font-size:18px;font-weight:600;color:var(--text);background:rgba(0,0,0,.28);border:1px solid var(--line);
    border-radius:13px;padding:12px 13px;outline:none;font-family:inherit}
  input.in:focus{border-color:var(--gold)}
  .result{margin-top:4px;padding:16px;border-radius:16px;text-align:center;background:linear-gradient(160deg,rgba(52,192,111,.25),rgba(52,192,111,.06));border:1px solid rgba(52,192,111,.5)}
  .result .big{font-size:34px;font-weight:900;color:var(--gold);line-height:1.1}
  .result .lbl{font-size:12.5px;color:var(--muted);margin-bottom:4px}
  .result .ln{font-size:14px;margin-top:6px}
  .formula{font-size:12px;color:var(--muted);margin-top:10px;line-height:1.4}
  /* сводка */
  .stats{display:grid;grid-template-columns:1fr 1fr;gap:10px}
  .stat{padding:16px 12px;border-radius:16px;background:var(--card);border:1px solid var(--line);text-align:center}
  .stat b{display:block;font-size:30px;color:var(--gold);font-weight:900}
  .stat span{font-size:12.5px;color:var(--muted)}
  ol.steps{margin:0;padding-left:20px;line-height:1.6;font-size:14.5px}
  /* нижние панели */
  .bar{position:fixed;left:0;right:0;bottom:calc(64px + env(safe-area-inset-bottom,0px));padding:10px 16px;
    background:linear-gradient(180deg,transparent,var(--bg) 40%);display:none}
  .bar.on{display:block}
  .btn{width:100%;border:0;border-radius:16px;padding:16px;font-size:17px;font-weight:800;color:#2a2000;font-family:inherit;
    background:linear-gradient(180deg,#ffd978,var(--gold2));box-shadow:0 8px 24px rgba(224,161,0,.35);cursor:pointer}
  .btn:disabled{opacity:.4;box-shadow:none}
  nav{position:fixed;left:0;right:0;bottom:0;display:flex;padding:6px 8px calc(6px + env(safe-area-inset-bottom,0px));
    background:rgba(5,32,26,.92);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border-top:1px solid var(--line)}
  nav button{flex:1;background:none;border:0;color:var(--muted);font-family:inherit;padding:6px 0;display:flex;flex-direction:column;
    align-items:center;gap:2px;font-size:11.5px;font-weight:700;cursor:pointer}
  nav button span{font-size:22px;filter:grayscale(1) opacity(.7)}
  nav button.on{color:var(--gold)} nav button.on span{filter:none}
  .toast{position:fixed;left:50%;top:calc(env(safe-area-inset-top,0px) + 70px);transform:translate(-50%,-20px);opacity:0;
    background:#10261d;border:1px solid var(--gold);color:var(--text);padding:11px 16px;border-radius:14px;font-size:14px;
    max-width:88%;text-align:center;pointer-events:none;transition:.25s;z-index:10}
  .toast.on{opacity:1;transform:translate(-50%,0)}
</style>
</head>
<body>
<header>
  <svg id="logo" width="44" height="44" viewBox="0 0 64 64" aria-hidden="true"></svg>
  <div>
    <div class="brand">АгроАрти</div>
    <div class="sub" id="who">Смарт-помощник агронома</div>
  </div>
</header>

<main>
  <!-- ===================== РАССЫЛКА ===================== -->
  <section id="tab-sched" class="on">
    <h2>Ежедневный отчёт</h2>
    <div class="card">
      <div class="row">
        <div><div class="title">Автоматическая рассылка</div>
          <div class="hint">Бот сам пришлёт отчёт в нужное время</div></div>
        <label class="sw"><input type="checkbox" id="on"><i></i></label>
      </div>
    </div>

    <h2>Время (московское)</h2>
    <div class="card"><div class="tpick"><select id="hh"></select><b>:</b><select id="mm"></select></div></div>

    <h2>Дни недели</h2>
    <div class="card"><div class="chips" id="days"></div></div>

    <h2>Что включить в отчёт</h2>
    <div class="card">
      <div class="seg c4" id="period"></div>
      <div class="hint" style="margin:10px 2px 8px">Формат</div>
      <div class="seg c2" id="fmt"></div>
    </div>

    <h2>Кому отправлять</h2>
    <div id="targets"></div>
    <div class="hint" id="noGroups" style="display:none;margin:-2px 4px 10px">
      Чтобы добавить чат: создайте группу, добавьте туда бота и напишите в ней <b>/connect Название</b>. Затем откройте приложение заново.
    </div>

    <h2>Итог</h2>
    <div class="preview" id="preview"></div>
  </section>

  <!-- ===================== РАСЧЁТЫ ===================== -->
  <section id="tab-calc">
    <h2>Выберите расчёт</h2>
    <div class="tiles" id="tiles"></div>
    <div id="calcBox" style="display:none">
      <h2 id="calcTitle"></h2>
      <div class="card" id="fields"></div>
      <div class="result" id="result"></div>
      <h2>Подпись (необязательно)</h2>
      <div class="card"><input class="in" id="label" maxlength="60" placeholder="Например: Поле №3, пшеница"></div>
    </div>
  </section>

  <!-- ===================== СВОДКА ===================== -->
  <section id="tab-info">
    <h2>Ваши данные</h2>
    <div class="stats">
      <div class="stat"><b id="sW">0</b><span>дел в журнале</span></div>
      <div class="stat"><b id="sC">0</b><span>расчётов</span></div>
      <div class="stat"><b id="sG">0</b><span>подключённых чатов</span></div>
      <div class="stat"><b id="sA">Выкл</b><span>автоотчёт</span></div>
    </div>
    <h2>Как пользоваться</h2>
    <div class="card"><ol class="steps">
      <li>Во вкладке «Расчёты» посчитайте и сохраните результат в журнал.</li>
      <li>Во вкладке «Рассылка» включите автоотчёт, выберите время и получателей.</li>
      <li>Нажмите «Сохранить»: приложение закроется, а бот подтвердит настройки в чате.</li>
    </ol></div>
    <div class="hint" style="margin:0 6px">Дела добавляются в чате кнопкой «📝 Добавить дело»: бот задаёт вопросы по шагам и записывает ФИО исполнителя.</div>
  </section>
</main>

<div class="bar" id="barSched"><button class="btn" id="saveSched">Сохранить настройки</button></div>
<div class="bar" id="barCalc"><button class="btn" id="saveCalc" disabled>Сохранить в журнал расчётов</button></div>

<nav>
  <button data-tab="sched" class="on"><span>⏰</span>Рассылка</button>
  <button data-tab="calc"><span>🧮</span>Расчёты</button>
  <button data-tab="info"><span>📊</span>Сводка</button>
</nav>
<div class="toast" id="toast"></div>

<script>
const tg = window.Telegram && window.Telegram.WebApp;
if (tg) { try { tg.ready(); tg.expand(); tg.setHeaderColor("#05201a"); tg.setBackgroundColor("#05201a"); } catch (e) {} }
const $ = (s) => document.querySelector(s);
const haptic = (k="light") => { try { tg.HapticFeedback.impactOccurred(k); } catch (e) {} };
let toastT;
function toast(msg){ const t=$("#toast"); t.textContent=msg; t.classList.add("on"); clearTimeout(toastT); toastT=setTimeout(()=>t.classList.remove("on"),2600); }

/* ---- логотип: колос ---- */
(function(){
  const g = [];
  for (let k=0;k<5;k++){ const y=46-k*8, s=1-k*.07;
    g.push(`<ellipse cx="${32-6*s}" cy="${y}" rx="${4.6*s}" ry="${9*s}" transform="rotate(-32 ${32-6*s} ${y})"/>`,
           `<ellipse cx="${32+6*s}" cy="${y}" rx="${4.6*s}" ry="${9*s}" transform="rotate(32 ${32+6*s} ${y})"/>`); }
  g.push(`<ellipse cx="32" cy="8.5" rx="4.4" ry="9.5"/>`);
  $("#logo").innerHTML = `<line x1="32" y1="62" x2="32" y2="30" stroke="#7ec36a" stroke-width="2.6" stroke-linecap="round"/><g fill="#ffcd50" stroke="#c98a00" stroke-width=".8">${g.join("")}</g>`;
})();

/* ---- данные, которые бот передал в адресе ---- */
function readParam(){
  try {
    const raw = new URLSearchParams(location.search).get("d");
    if (!raw) return null;
    const b = raw.replace(/-/g,"+").replace(/_/g,"/"); const pad = "=".repeat((4 - b.length % 4) % 4);
    const bin = atob(b + pad); const bytes = Uint8Array.from(bin, c => c.charCodeAt(0));
    return JSON.parse(new TextDecoder("utf-8").decode(bytes));
  } catch (e) { return null; }
}
const P = readParam() || {};
const sch = Object.assign({on:false,time:"18:00",days:[0,1,2,3,4,5,6],period:"day",fmt:"excel",targets:["me"]}, P.sch || {});
const groups = P.groups || [];
if (P.name) $("#who").textContent = P.name + " · смарт-помощник агронома";
$("#sW").textContent = (P.st && P.st.w) || 0; $("#sC").textContent = (P.st && P.st.c) || 0;
$("#sG").textContent = groups.length; $("#sA").textContent = sch.on ? "Вкл" : "Выкл";

/* ---- вкладки ---- */
function showTab(name){
  document.querySelectorAll("section").forEach(s => s.classList.toggle("on", s.id === "tab-" + name));
  document.querySelectorAll("nav button").forEach(b => b.classList.toggle("on", b.dataset.tab === name));
  $("#barSched").classList.toggle("on", name === "sched");
  $("#barCalc").classList.toggle("on", name === "calc" && !!current);
  $("main").scrollTop = 0; haptic();
}
document.querySelectorAll("nav button").forEach(b => b.onclick = () => showTab(b.dataset.tab));

/* ---- рассылка ---- */
const DAYS = ["Пн","Вт","Ср","Чт","Пт","Сб","Вс"];
const PERIODS = {day:"Сегодня", week:"7 дней", month:"Месяц", all:"Всё время"};
const PERIOD_TXT = {day:"за сегодня", week:"за 7 дней", month:"за месяц", all:"за всё время"};
const FORMATS = {excel:"Excel-файл", text:"Текст"};
$("#on").checked = !!sch.on;
const getTime = () => $("#hh").value + ":" + $("#mm").value;
(function(){
  const pad = n => String(n).padStart(2, "0");
  $("#hh").innerHTML = Array.from({length:24}, (_, i) => `<option>${pad(i)}</option>`).join("");
  $("#mm").innerHTML = Array.from({length:60}, (_, i) => `<option>${pad(i)}</option>`).join("");
  const [h, m] = (sch.time || "18:00").split(":"); $("#hh").value = pad(+h); $("#mm").value = pad(+m);
})();

function drawChoices(){
  $("#days").innerHTML = DAYS.map((d,i)=>`<div class="chip ${sch.days.includes(i)?"on":""}" data-d="${i}">${d}</div>`).join("");
  $("#period").innerHTML = Object.entries(PERIODS).map(([k,v])=>`<div class="chip ${sch.period===k?"on":""}" data-p="${k}">${v}</div>`).join("");
  $("#fmt").innerHTML = Object.entries(FORMATS).map(([k,v])=>`<div class="chip ${sch.fmt===k?"on":""}" data-f="${k}">${v}</div>`).join("");
  const items = [{i:"me", n:"Мне в личные сообщения"}].concat(groups.map(g=>({i:g.i, n:g.n})));
  $("#targets").innerHTML = items.map(t=>`<div class="rcpt ${sch.targets.includes(t.i)?"on":""}" data-t="${t.i}"><div class="box">✓</div><div class="title">${t.n.replace(/</g,"&lt;")}</div></div>`).join("");
  $("#noGroups").style.display = groups.length ? "none" : "block";
  preview();
}
function preview(){
  const names = {me:"вам в личку"}; groups.forEach(g => names[g.i] = "«" + g.n + "»");
  const days = sch.days.length === 7 ? "каждый день" : (sch.days.length ? "по " + sch.days.slice().sort().map(i=>DAYS[i]).join(", ") : "дни не выбраны");
  const to = sch.targets.map(t=>names[t]).filter(Boolean).join(", ") || "получатели не выбраны";
  $("#preview").innerHTML = $("#on").checked
    ? `Бот отправит <b>${FORMATS[sch.fmt]}</b> ${PERIOD_TXT[sch.period]}: <b>${days}</b> в <b>${getTime()}</b> → ${to}.`
    : `Автоотчёт <b>выключен</b>. Включите переключатель вверху, чтобы бот начал присылать отчёты.`;
}
document.addEventListener("click", (e) => {
  const c = e.target.closest(".chip,.rcpt"); if (!c) return;
  if (c.dataset.d !== undefined){ const i=+c.dataset.d; sch.days = sch.days.includes(i) ? sch.days.filter(x=>x!==i) : sch.days.concat(i); }
  else if (c.dataset.p){ sch.period = c.dataset.p; }
  else if (c.dataset.f){ sch.fmt = c.dataset.f; }
  else if (c.dataset.t){ const t=c.dataset.t; sch.targets = sch.targets.includes(t) ? sch.targets.filter(x=>x!==t) : sch.targets.concat(t); }
  else return;
  haptic(); drawChoices();
});
$("#on").onchange = () => { haptic("medium"); preview(); };
$("#hh").onchange = $("#mm").onchange = () => { haptic(); preview(); };

function send(payload){
  if (!tg || typeof tg.sendData !== "function") { toast("Откройте приложение кнопкой «📱 Мини-приложение» в чате с ботом"); return; }
  try { tg.HapticFeedback.notificationOccurred("success"); } catch (e) {}
  tg.sendData(JSON.stringify(payload));
}
$("#saveSched").onclick = () => {
  const on = $("#on").checked;
  if (on && !sch.days.length) return toast("Выберите хотя бы один день недели");
  if (on && !sch.targets.length) return toast("Выберите хотя бы одного получателя");
    send({type:"schedule", on, time:getTime(), days:sch.days.slice().sort(), period:sch.period, fmt:sch.fmt, targets:sch.targets});
};
drawChoices();
$("#barSched").classList.add("on");

/* ---- расчёты (те же формулы, что в боте) ---- */
const nf = new Intl.NumberFormat("ru-RU", {maximumFractionDigits:2});
const rub = v => nf.format(v) + " ₽";
const CALCS = {
  smeta:{ic:"📋",t:"Смета",d:"затраты на работы по полю",
    f:[["Площадь, га"],["Семена, ₽/га"],["Удобрения, ₽/га"],["Топливо, ₽/га"],["Прочее, ₽/га"]],
    fn:v=>{const per=v[1]+v[2]+v[3]+v[4], tot=per*v[0]; return {lbl:"Итого по смете",big:rub(tot),lines:["Затраты на 1 га: "+rub(per)],
      formula:"смета = площадь × (семена + удобрения + топливо + прочее на 1 га)"};}},
  area:{ic:"📐",t:"Гектары",d:"метры → гектары и сотки",
    f:[["Длина, м"],["Ширина, м"]],
    fn:v=>{const m2=v[0]*v[1]; return {lbl:"Площадь участка",big:nf.format(m2/10000)+" га",lines:[nf.format(m2)+" м²  ·  "+nf.format(m2/100)+" соток"],
      formula:"га = длина × ширина (в метрах) ÷ 10 000"};}},
  cost:{ic:"💰",t:"Себестоимость",d:"сколько стоит 1 центнер",
    f:[["Общие затраты, ₽"],["Площадь, га"],["Валовой сбор, ц"]],
    fn:v=>{if(!v[1]||!v[2]) return null; return {lbl:"Себестоимость 1 ц",big:rub(v[0]/v[2]),lines:["Затраты на 1 га: "+rub(v[0]/v[1]),"Урожайность: "+nf.format(v[2]/v[1])+" ц/га"],
      formula:"себестоимость = общие затраты ÷ валовой сбор"};}},
  profit:{ic:"📈",t:"Окупаемость",d:"выручка, прибыль, рентабельность",
    f:[["Общие затраты, ₽"],["Валовой сбор, ц"],["Цена за 1 ц, ₽"]],
    fn:v=>{if(!v[0]) return null; const rev=v[1]*v[2], pr=rev-v[0]; return {lbl:"Прибыль",big:rub(pr),lines:["Выручка: "+rub(rev),"Рентабельность: "+nf.format(pr/v[0]*100)+" %"],
      formula:"прибыль = сбор × цена − затраты; рентабельность = прибыль ÷ затраты × 100 %"};}},
};
let current = null;
$("#tiles").innerHTML = Object.entries(CALCS).map(([k,c])=>`<div class="tile" data-k="${k}"><div class="ic">${c.ic}</div><div class="t">${c.t}</div><div class="d">${c.d}</div></div>`).join("");
document.querySelectorAll(".tile").forEach(t => t.onclick = () => openCalc(t.dataset.k));

function openCalc(k){
  current = k; haptic();
  document.querySelectorAll(".tile").forEach(t => t.classList.toggle("on", t.dataset.k === k));
  $("#calcBox").style.display = "block"; $("#calcTitle").textContent = CALCS[k].t;
  $("#fields").innerHTML = CALCS[k].f.map((f,i)=>`<label class="f"><span>${f[0]}</span><input class="in num" inputmode="decimal" data-i="${i}" placeholder="0"></label>`).join("");
  document.querySelectorAll(".num").forEach(inp => inp.oninput = recalc);
  $("#barCalc").classList.add("on"); recalc();
  setTimeout(()=>$("#calcBox").scrollIntoView({behavior:"smooth",block:"start"}),50);
}
function values(){ return [...document.querySelectorAll(".num")].map(i => { const t=i.value.replace(",",".").trim(); return t===""?NaN:Number(t); }); }
function recalc(){
  const v = values(), ok = v.every(x => Number.isFinite(x) && x >= 0);
  let r = ok ? CALCS[current].fn(v) : null;
  $("#saveCalc").disabled = !r;
  $("#result").innerHTML = r
    ? `<div class="lbl">${r.lbl}</div><div class="big">${r.big}</div>${r.lines.map(l=>`<div class="ln">${l}</div>`).join("")}<div class="formula">Формула: ${r.formula}</div>`
    : `<div class="lbl">Заполните все поля, и результат появится здесь</div>`;
}
$("#saveCalc").onclick = () => send({type:"calc", kind:current, values:values(), label:$("#label").value.trim()});
</script>
</body>
</html>
